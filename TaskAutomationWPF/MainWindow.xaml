<Window x:Class="TaskAutomationWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Automation Tool" Height="250" Width="400">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Exportar Tareas a Excel" Click="ExportTasks_Click" Width="250" Height="40" Margin="0,5,0,5"/>
            <Button Content="Enviar Correo" Click="SendEmail_Click" Width="250" Height="40" Margin="0,5,0,5"/>
            <Button Content="Salir" Click="Exit_Click" Width="250" Height="40" Margin="0,5,0,5"/>
        </StackPanel>
    </Grid>
</Window>
